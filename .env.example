# Copy to .env.local and fill in. Never commit .env.local.

# Public site address, no trailing slash. Used for canonical URLs, hreflang,
# sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.tatsianabandziuk.com

# Sanity (manage.sanity.io → project)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only. Required: translated documents (ids with a dot) are private.
# Create in manage.sanity.io → API → Tokens, "Editor" permissions.
SANITY_API_TOKEN=
# (SANITY_API_WRITE_TOKEN is accepted as an alternative name)

# Contact form mail (SMTP). Enquiries are sent to EMAIL_TO (defaults to EMAIL_USER).
SMTP_HOST=
SMTP_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TO=

# Analytics — leave empty to disable.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# IndexNow + publish webhook (manage.sanity.io → API → Webhooks → /api/indexnow/webhook)
INDEXNOW_KEY=
INDEXNOW_WEBHOOK_SECRET=

# DataForSEO — used only by local scripts for keyword research, never by the site.
DATAFORSEO_API_LOGIN=
DATAFORSEO_API_PASSWORD=
